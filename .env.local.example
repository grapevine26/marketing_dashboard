# Gemini (AI 보조 기능). 없으면 AI 기능만 꺼진다.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (운영 프로젝트). Project Settings → API / Connect 에서 복사한다.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here
# 마이그레이션 적용용(npm run db:migrate). 반드시 Session pooler 주소를 쓴다. 직접 연결 주소는 IPv6 전용이라 안 붙는 PC 가 많다.
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Supabase (테스트 전용 프로젝트). DB 를 건드리는 단위 테스트가 매번 모든 테이블을 비우므로 운영과 반드시 다른 프로젝트여야 한다.
# 없으면 DB 테스트는 skip 된다. 스키마는 npm run db:migrate -- --test 로 맞춘다.
SUPABASE_TEST_URL=https://yyyy.supabase.co
SUPABASE_TEST_SERVICE_ROLE_KEY=test_service_role_key_here
SUPABASE_TEST_DB_URL=postgresql://postgres.yyyy:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 파일 저장소 (선택). Vercel 배포에서 Blob 스토어를 연결하면 자동으로 들어온다. 로컬은 .data/uploads 를 쓴다.
# BLOB_READ_WRITE_TOKEN=
